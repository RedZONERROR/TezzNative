####################################
# Application
####################################
APP_ENV=production
APP_URL=https://tn.tezzcorp.com
APP_TIMEZONE=Asia/Kolkata

# Generate once and NEVER change in production
APP_SECRET=REPLACE_WITH_RANDOM_64_HEX_STRING

# Hostinger proxy/CDN
TRUST_PROXY=1

# Cookies
COOKIE_DOMAIN=.tezzcorp.com
SESSION_NAME=tezzcorp_sid

####################################
# Logs
####################################
LOG_PATH=/home/USERNAME/domains/tezzcorp.com/logs

####################################
# Database
####################################
DB_HOST=localhost
DB_PORT=3306
DB_NAME=DB_NAME_HERE
DB_USER=DB_USER_HERE
DB_PASS=DB_PASS_HERE
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

####################################
# PhonePe (Production)
####################################
PHONEPE_MERCHANT_ID=YOUR_MERCHANT_ID
PHONEPE_API_KEY=YOUR_API_KEY
PHONEPE_SALT_INDEX=1
PHONEPE_MODE=production

####################################
# Email / SMTP
####################################
EMAIL_FROM=info@tezzcorp.com
EMAIL_FROM_NAME=TezzCorp Pvt Ltd
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USERNAME=info@tezzcorp.com
SMTP_PASSWORD=SMTP_PASS_HERE
SMTP_SECURE=tls

####################################
# CRM / App Settings
####################################
SITE_NAME=TezzCorp CRM
DATE_FORMAT=d M Y
RECORDS_PER_PAGE=10
