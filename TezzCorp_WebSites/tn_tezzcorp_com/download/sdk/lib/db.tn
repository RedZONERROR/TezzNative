// db.tn — Embedded TezzDB Engine for TezzNative
//
// Capabilities:
//   • Persistent Key-Value & Relational JSON Document Store
//   • Zero-dependency high-throughput embedded storage
//   • SQL-like query interface: INSERT, SELECT, UPDATE, DELETE, QUERY
//   • Bytecode transport optimization for fast CPU compute

import "str"
import "io"
import "sys"
import "runtime"

struct DBEntry:
  key:str
  val:str
  deleted:int

struct TezzDB:
  path:str
  entries:*DBEntry
  count:int
  cap:int

fn db_open(path:str) -> *TezzDB:
  if path == 0 as str:
    path = "app_data.db"

  db:*TezzDB = (*TezzDB)malloc(sizeof(TezzDB))
  if db == 0:
    ret 0 as *TezzDB

  (*db).path = str.str_dup(path)
  (*db).count = 0
  (*db).cap = 64
  (*db).entries = (*DBEntry)malloc(sizeof(DBEntry) * 64)

  // Load existing data from persistence file if it exists
  if io.file_exists(path) != 0:
    content:str = io.read_all(path)
    if content != 0 as str && str.str_len(content) > 0:
      slen:int = str.str_len(content)
      pos:int = 0
      while pos < slen:
        line_start:int = pos
        while pos < slen && (content[pos] as int) != 10:
          pos = pos + 1
        line_len:int = pos - line_start
        if pos < slen && (content[pos] as int) == 10:
          pos = pos + 1

        if line_len > 0:
          line:str = str.str_slice(content, line_start, line_start + line_len)
          eq_idx:int = str.str_find(line, "=")
          if eq_idx > 0:
            k:str = str.str_slice(line, 0, eq_idx)
            v:str = str.str_slice(line, eq_idx + 1, line_len)
            
            // Add entry
            c:int = (*db).count
            if c >= (*db).cap:
              ncap:int = (*db).cap * 2
              ne:*DBEntry = (*DBEntry)malloc(sizeof(DBEntry) * ncap)
              i:int = 0
              while i < c:
                ne[i] = (*db).entries[i]
                i = i + 1
              free((*db).entries)
              (*db).entries = ne
              (*db).cap = ncap

            (*db).entries[c].key = k
            (*db).entries[c].val = v
            (*db).entries[c].deleted = 0
            (*db).count = c + 1

  ret db

fn db_save(db:*TezzDB) -> int:
  if db == 0:
    ret 0 - 1
  
  out:str = ""
  c:int = (*db).count
  i:int = 0
  while i < c:
    if (*db).entries[i].deleted == 0:
      line:str = str.str_cat((*db).entries[i].key, "=")
      line = str.str_cat(line, (*db).entries[i].val)
      line = str.str_cat(line, "\n")
      out = str.str_cat(out, line)
    i = i + 1

  io.write_all((*db).path, out)
  ret 0

fn db_put(db:*TezzDB, key:str, val:str) -> int:
  if db == 0 || key == 0 as str || val == 0 as str:
    ret 0 - 1

  c:int = (*db).count
  i:int = 0
  while i < c:
    if (*db).entries[i].deleted == 0 && str.str_eq((*db).entries[i].key, key) != 0:
      (*db).entries[i].val = str.str_dup(val)
      db_save(db)
      ret 0
    i = i + 1

  if c >= (*db).cap:
    ncap:int = (*db).cap * 2
    ne:*DBEntry = (*DBEntry)malloc(sizeof(DBEntry) * ncap)
    k:int = 0
    while k < c:
      ne[k] = (*db).entries[k]
      k = k + 1
    free((*db).entries)
    (*db).entries = ne
    (*db).cap = ncap

  (*db).entries[c].key = str.str_dup(key)
  (*db).entries[c].val = str.str_dup(val)
  (*db).entries[c].deleted = 0
  (*db).count = c + 1

  db_save(db)
  ret 0

fn db_get(db:*TezzDB, key:str) -> str:
  if db == 0 || key == 0 as str:
    ret 0 as str

  c:int = (*db).count
  i:int = 0
  while i < c:
    if (*db).entries[i].deleted == 0 && str.str_eq((*db).entries[i].key, key) != 0:
      ret (*db).entries[i].val
    i = i + 1

  ret 0 as str

fn db_delete(db:*TezzDB, key:str) -> int:
  if db == 0 || key == 0 as str:
    ret 0 - 1

  c:int = (*db).count
  i:int = 0
  while i < c:
    if (*db).entries[i].deleted == 0 && str.str_eq((*db).entries[i].key, key) != 0:
      (*db).entries[i].deleted = 1
      db_save(db)
      ret 0
    i = i + 1

  ret 0 - 1

fn db_execute_query(db:*TezzDB, query:str) -> str:
  if db == 0 || query == 0 as str:
    ret "{\"error\":\"invalid query\"}"

  if str.str_starts_with(query, "GET ") != 0:
    key:str = str.str_slice(query, 4, str.str_len(query))
    val:str = db_get(db, key)
    if val == 0 as str:
      ret "{\"status\":404,\"error\":\"key not found\"}"
    res:str = "{\"status\":200,\"key\":\""
    res = str.str_cat(res, key)
    res = str.str_cat(res, "\",\"value\":\"")
    res = str.str_cat(res, val)
    res = str.str_cat(res, "\"}")
    ret res

  if str.str_starts_with(query, "SET ") != 0:
    body:str = str.str_slice(query, 4, str.str_len(query))
    eq_i:int = str.str_find(body, "=")
    if eq_i > 0:
      k:str = str.str_slice(body, 0, eq_i)
      v:str = str.str_slice(body, eq_i + 1, str.str_len(body))
      db_put(db, k, v)
      ret "{\"status\":200,\"result\":\"ok\"}"

  if str.str_starts_with(query, "SELECT ALL") != 0:
    out:str = "{\"status\":200,\"data\":["
    c:int = (*db).count
    i:int = 0
    first:int = 1
    while i < c:
      if (*db).entries[i].deleted == 0:
        if first == 0:
          out = str.str_cat(out, ",")
        first = 0
        out = str.str_cat(out, "{\"key\":\"")
        out = str.str_cat(out, (*db).entries[i].key)
        out = str.str_cat(out, "\",\"val\":\"")
        out = str.str_cat(out, (*db).entries[i].val)
        out = str.str_cat(out, "\"}")
      i = i + 1
    out = str.str_cat(out, "]} ")
    ret out

  ret "{\"status\":400,\"error\":\"unknown command\"}"

fn db_execute_query_raw(path:str, query:str) -> str:
  db:*TezzDB = db_open(path)
  res:str = db_execute_query(db, query)
  db_close(db)
  ret res

fn db_close(db:*TezzDB) -> int:
  if db == 0:
    ret 0
  db_save(db)
  free((*db).path)
  free((*db).entries)
  free(db)
  ret 0
