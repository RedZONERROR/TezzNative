import "tensor"
import "tnx"

let MODEL_DTYPE_F32:int = 0
let MODEL_DTYPE_BOOL:int = 2

struct DenseModel:
  name:str
  in_dim:int
  out_dim:int
  w:*Tensor
  b:*Tensor

fn _mdl_strdup(s:str) -> str:
  if s == 0:
    ret 0 as str
  n:int = len(s)
  out:*char = (*char)malloc(n + 1)
  if out == 0:
    ret 0 as str
  i:int = 0
  while i < n:
    out[i] = s[i]
    i = i + 1
  out[n] = 0 as char
  ret out

fn _mdl_name(s:str) -> str:
  if s == 0 || len(s) == 0:
    ret "dense"
  ret s

fn dense_new(in_dim:int, out_dim:int, name:str) -> *DenseModel:
  if in_dim <= 0 || out_dim <= 0:
    ret 0 as *DenseModel
  m:*DenseModel = (*DenseModel)malloc(sizeof(DenseModel))
  if m == 0:
    ret 0 as *DenseModel
  (*m).name = _mdl_strdup(_mdl_name(name))
  (*m).in_dim = in_dim
  (*m).out_dim = out_dim
  (*m).w = 0 as *Tensor
  (*m).b = 0 as *Tensor

  w_shape:[int;2] = [in_dim, out_dim]
  b_shape:[int;1] = [out_dim]
  (*m).w = tensor.tensor_new(&w_shape[0], 2, 1)
  (*m).b = tensor.tensor_new(&b_shape[0], 1, 1)
  if (*m).w == 0 || (*m).b == 0:
    dense_free(m)
    ret 0 as *DenseModel

  i:int = 0
  w_len:int = tensor.tensor_len((*m).w)
  while i < w_len:
    v:float = ((i % 97) - 48) as float / 97.0
    tensor.tensor_set_f((*m).w, i, v)
    i = i + 1
  i = 0
  while i < tensor.tensor_len((*m).b):
    tensor.tensor_set_f((*m).b, i, 0.0)
    i = i + 1
  ret m

fn dense_free(m:*DenseModel) -> int:
  if m == 0:
    ret 0
  if (*m).w != 0:
    tensor.tensor_free((*m).w)
  if (*m).b != 0:
    tensor.tensor_free((*m).b)
  if (*m).name != 0:
    free((*m).name as *char)
  free(m as *char)
  ret 0

fn dense_forward(m:*DenseModel, x:*Tensor) -> *Tensor:
  if m == 0 || x == 0:
    ret 0 as *Tensor
  if tensor.tensor_rank(x) != 2:
    ret 0 as *Tensor
  if tensor.tensor_dim(x, 1) != (*m).in_dim:
    ret 0 as *Tensor
  y:*Tensor = tensor.tensor_matmul(x, (*m).w)
  if y == 0:
    ret 0 as *Tensor
  out:*Tensor = tensor.tensor_add(y, (*m).b)
  tensor.tensor_free(y)
  ret out

fn tensor_save_tnxb(t:*Tensor, path:str) -> int:
  if t == 0 || path == 0:
    ret 0 - 1
  root:*TnxValue = tnx.obj()
  if root == 0:
    ret 0 - 1
  schema_v:*TnxValue = tnx.tnx_str("tezz_tensor_v1")
  if tnx.obj_set(root, "schema", schema_v) != 0:
    tnx.release(root)
    ret 0 - 1
  dtype_v:*TnxValue = tnx.tnx_int(tensor.tensor_dtype(t))
  if tnx.obj_set(root, "dtype", dtype_v) != 0:
    tnx.release(root)
    ret 0 - 1
  rank_v:*TnxValue = tnx.tnx_int(tensor.tensor_rank(t))
  if tnx.obj_set(root, "rank", rank_v) != 0:
    tnx.release(root)
    ret 0 - 1
  shape:*TnxValue = tnx.arr()
  if shape == 0:
    tnx.release(root)
    ret 0 - 1
  i:int = 0
  while i < tensor.tensor_rank(t):
    dim_v:*TnxValue = tnx.tnx_int(tensor.tensor_dim(t, i))
    if tnx.arr_push(shape, dim_v) != 0:
      tnx.release(root)
      ret 0 - 1
    i = i + 1
  if tnx.obj_set(root, "shape", shape) != 0:
    tnx.release(root)
    ret 0 - 1
  data:*TnxValue = tnx.arr()
  if data == 0:
    tnx.release(root)
    ret 0 - 1
  i = 0
  n:int = tensor.tensor_len(t)
  dt:int = tensor.tensor_dtype(t)
  while i < n:
    if dt == MODEL_DTYPE_F32:
      fv:*TnxValue = tnx.tnx_float(tensor.tensor_get_f(t, i))
      if tnx.arr_push(data, fv) != 0:
        tnx.release(root)
        ret 0 - 1
    else:
      if dt == MODEL_DTYPE_BOOL:
        bv:*TnxValue = tnx.tnx_int(tensor.tensor_get_b(t, i))
        if tnx.arr_push(data, bv) != 0:
          tnx.release(root)
          ret 0 - 1
      else:
        iv:*TnxValue = tnx.tnx_int(tensor.tensor_get_i(t, i))
        if tnx.arr_push(data, iv) != 0:
          tnx.release(root)
          ret 0 - 1
    i = i + 1
  if tnx.obj_set(root, "data", data) != 0:
    tnx.release(root)
    ret 0 - 1
  rc:int = tnx.save_b(path, root)
  tnx.release(root)
  ret rc

fn tensor_load_tnxb(path:str) -> *Tensor:
  if path == 0:
    ret 0 as *Tensor
  root:*TnxValue = tnx.load_b(path)
  if root == 0:
    root = tnx.load(path)
  if root == 0:
    ret 0 as *Tensor
  schema:*TnxValue = tnx.obj_get(root, "schema")
  if schema == 0 || tnx.tnx_as_str(schema) == 0 || strcmp(tnx.tnx_as_str(schema), "tezz_tensor_v1") != 0:
    tnx.release(root)
    ret 0 as *Tensor
  dt:int = tnx.tnx_as_int(tnx.obj_get(root, "dtype"))
  rank:int = tnx.tnx_as_int(tnx.obj_get(root, "rank"))
  if rank <= 0 || rank > 8:
    tnx.release(root)
    ret 0 as *Tensor
  shape_buf:[int;8]
  shape_v:*TnxValue = tnx.obj_get(root, "shape")
  i:int = 0
  while i < rank:
    d:*TnxValue = tnx.arr_get(shape_v, i)
    if d == 0:
      tnx.release(root)
      ret 0 as *Tensor
    shape_buf[i] = tnx.tnx_as_int(d)
    if shape_buf[i] <= 0:
      tnx.release(root)
      ret 0 as *Tensor
    i = i + 1
  t:*Tensor = tensor.tensor_new_dtype(&shape_buf[0], rank, dt, 0)
  if t == 0:
    tnx.release(root)
    ret 0 as *Tensor
  data_v:*TnxValue = tnx.obj_get(root, "data")
  i = 0
  n:int = tensor.tensor_len(t)
  while i < n:
    v:*TnxValue = tnx.arr_get(data_v, i)
    if v == 0:
      tensor.tensor_free(t)
      tnx.release(root)
      ret 0 as *Tensor
    if dt == MODEL_DTYPE_F32:
      tensor.tensor_set_f(t, i, tnx.tnx_as_float(v))
    else:
      if dt == MODEL_DTYPE_BOOL:
        tensor.tensor_set_b(t, i, tnx.tnx_as_int(v))
      else:
        tensor.tensor_set_i(t, i, tnx.tnx_as_int(v))
    i = i + 1
  tnx.release(root)
  ret t

fn dense_save(m:*DenseModel, path:str) -> int:
  if m == 0 || path == 0:
    ret 0 - 1
  root:*TnxValue = tnx.obj()
  if root == 0:
    ret 0 - 1
  schema_v:*TnxValue = tnx.tnx_str("tezz_dense_v1")
  if tnx.obj_set(root, "schema", schema_v) != 0:
    tnx.release(root)
    ret 0 - 1
  name_v:*TnxValue = tnx.tnx_str(_mdl_name((*m).name))
  if tnx.obj_set(root, "name", name_v) != 0:
    tnx.release(root)
    ret 0 - 1
  in_v:*TnxValue = tnx.tnx_int((*m).in_dim)
  if tnx.obj_set(root, "in_dim", in_v) != 0:
    tnx.release(root)
    ret 0 - 1
  out_v:*TnxValue = tnx.tnx_int((*m).out_dim)
  if tnx.obj_set(root, "out_dim", out_v) != 0:
    tnx.release(root)
    ret 0 - 1

  w_arr:*TnxValue = tnx.arr()
  if w_arr == 0:
    tnx.release(root)
    ret 0 - 1
  i:int = 0
  while i < tensor.tensor_len((*m).w):
    wv:*TnxValue = tnx.tnx_float(tensor.tensor_get_f((*m).w, i))
    if tnx.arr_push(w_arr, wv) != 0:
      tnx.release(root)
      ret 0 - 1
    i = i + 1
  if tnx.obj_set(root, "w", w_arr) != 0:
    tnx.release(root)
    ret 0 - 1

  b_arr:*TnxValue = tnx.arr()
  if b_arr == 0:
    tnx.release(root)
    ret 0 - 1
  i = 0
  while i < tensor.tensor_len((*m).b):
    bv:*TnxValue = tnx.tnx_float(tensor.tensor_get_f((*m).b, i))
    if tnx.arr_push(b_arr, bv) != 0:
      tnx.release(root)
      ret 0 - 1
    i = i + 1
  if tnx.obj_set(root, "b", b_arr) != 0:
    tnx.release(root)
    ret 0 - 1

  rc:int = tnx.save_b(path, root)
  tnx.release(root)
  ret rc

fn dense_load(path:str) -> *DenseModel:
  if path == 0:
    ret 0 as *DenseModel
  root:*TnxValue = tnx.load_b(path)
  if root == 0:
    root = tnx.load(path)
  if root == 0:
    ret 0 as *DenseModel
  schema:*TnxValue = tnx.obj_get(root, "schema")
  if schema == 0 || tnx.tnx_as_str(schema) == 0 || strcmp(tnx.tnx_as_str(schema), "tezz_dense_v1") != 0:
    tnx.release(root)
    ret 0 as *DenseModel

  in_dim:int = tnx.tnx_as_int(tnx.obj_get(root, "in_dim"))
  out_dim:int = tnx.tnx_as_int(tnx.obj_get(root, "out_dim"))
  name_v:*TnxValue = tnx.obj_get(root, "name")
  name_s:str = "dense"
  if name_v != 0 && tnx.tnx_as_str(name_v) != 0:
    name_s = tnx.tnx_as_str(name_v)

  m:*DenseModel = dense_new(in_dim, out_dim, name_s)
  if m == 0:
    tnx.release(root)
    ret 0 as *DenseModel

  w_arr:*TnxValue = tnx.obj_get(root, "w")
  b_arr:*TnxValue = tnx.obj_get(root, "b")
  i:int = 0
  while i < tensor.tensor_len((*m).w):
    item:*TnxValue = tnx.arr_get(w_arr, i)
    if item == 0:
      dense_free(m)
      tnx.release(root)
      ret 0 as *DenseModel
    tensor.tensor_set_f((*m).w, i, tnx.tnx_as_float(item))
    i = i + 1
  i = 0
  while i < tensor.tensor_len((*m).b):
    item_b:*TnxValue = tnx.arr_get(b_arr, i)
    if item_b == 0:
      dense_free(m)
      tnx.release(root)
      ret 0 as *DenseModel
    tensor.tensor_set_f((*m).b, i, tnx.tnx_as_float(item_b))
    i = i + 1
  tnx.release(root)
  ret m
