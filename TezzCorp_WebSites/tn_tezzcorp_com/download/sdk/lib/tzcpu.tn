// ── High-Level Convenience Helpers ───────────────────────────────────────────

fn malloc_f32(n: int) -> int:
  ret tz_cpu_malloc(n * 4)

fn zeros_f32(n: int) -> int:
  ret tz_cpu_zeros(n)

fn free_buf(ptr: int) -> int:
  ret tz_cpu_free(ptr)

fn fill_f32(buf: int, n: int, val: float) -> int:
  ret tz_cpu_fill_f32(buf, n, val)

fn copy_f32(src: int, dst: int, n: int) -> int:
  ret tz_cpu_copy_f32(src, dst, n)

fn gemm_f32(A: int, B: int, C: int, M: int, K: int, N: int, alpha: float, beta: float) -> int:
  ret tz_cpu_gemm_f32(A, B, C, M, K, N, alpha, beta)

fn linear_f32(X: int, W: int, b: int, Y: int, batch: int, in_dim: int, out_dim: int) -> int:
  tz_cpu_gemm_nt_f32(X, W, Y, batch, in_dim, out_dim, 1.0, 0.0)
  if b != 0:
    tz_cpu_add_bias_f32(Y, b, batch, out_dim)
  ret Y

fn relu_f32(a: int, c: int, n: int) -> int:
  ret tz_cpu_relu_f32(a, c, n)

fn gelu_f32(a: int, c: int, n: int) -> int:
  ret tz_cpu_gelu_f32(a, c, n)

fn softmax_f32(x: int, rows: int, cols: int) -> int:
  ret tz_cpu_softmax_f32(x, rows, cols)

fn cross_entropy_f32(logits: int, labels: int, loss_buf: int, batch: int, classes: int) -> int:
  ret tz_cpu_cross_entropy_f32(logits, labels, loss_buf, batch, classes)

fn cross_entropy_bwd_f32(logits: int, labels: int, grad: int, batch: int, classes: int) -> int:
  ret tz_cpu_cross_entropy_bwd_f32(logits, labels, grad, batch, classes)

fn adam_f32(p: int, g: int, m: int, v: int, lr: float, b1: float, b2: float, eps: float, b1t: float, b2t: float, n: int) -> int:
  ret tz_cpu_adam_f32(p, g, m, v, lr, b1, b2, eps, b1t, b2t, n)

fn xavier_init_f32(W: int, n: int, fan_in: int, seed: int) -> int:
  ret tz_cpu_xavier_init_f32(W, n, fan_in, seed)

fn embedding_f32(indices: int, table: int, out: int, T_: int, D_: int) -> int:
  ret tz_cpu_embedding_f32(indices, table, out, T_, D_)

fn attention_f32(Q: int, K_: int, V_: int, out: int, B_: int, T_: int, D_: int, causal: int) -> int:
  ret tz_cpu_attention_f32(Q, K_, V_, out, B_, T_, D_, causal)

fn rmsnorm_f32(x: int, w: int, out: int, B_: int, D_: int, eps_bits: int) -> int:
  ret tz_cpu_rmsnorm_f32(x, w, out, B_, D_, eps_bits)

fn rope_f32(x: int, out: int, T_: int, D_: int, pos_offset: int) -> int:
  ret tz_cpu_rope_f32(x, out, T_, D_, pos_offset)

fn argmax_f32(x: int, n: int) -> int:
  ret tz_cpu_argmax_f32(x, n)

fn get_loss_f32(buf: int, n: int) -> int:
  ret tz_cpu_get_loss_f32(buf, n)

fn print_tensor(ptr: int, n: int) -> int:
  ret tz_cpu_print_tensor_f32(ptr, n, 8)

fn check_finite(ptr: int, n: int) -> int:
  ret tz_cpu_check_finite_f32(ptr, n)

fn sync() -> int:
  ret tz_cpu_sync()

fn info() -> int:
  ret tz_cpu_info()

