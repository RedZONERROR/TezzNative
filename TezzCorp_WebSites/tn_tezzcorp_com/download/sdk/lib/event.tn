// event module: deterministic UI/input event queue primitives.

struct TzEvent:
  kind:int
  key:int
  x:int
  y:int
  buttons:int
  mods:int
  data:int

struct TzEventQueue:
  head:int
  tail:int
  len:int
  dropped:int
  events:[TzEvent;256]

let TZ_EVENT_NONE:int = 0
let TZ_EVENT_KEY:int = 1
let TZ_EVENT_POINTER:int = 2
let TZ_EVENT_BUTTON:int = 3
let TZ_EVENT_CUSTOM:int = 4
let TZ_EVENT_IME:int = 5
let TZ_EVENT_WINDOW:int = 6
let TZ_EVENT_QUEUE_CAP:int = 256

fn tz_event_queue_init(q:*TzEventQueue) -> int:
  if q == 0: ret 0 - 1
  (*q).head = 0
  (*q).tail = 0
  (*q).len = 0
  (*q).dropped = 0
  ret 0

fn tz_event_queue_clear(q:*TzEventQueue) -> int:
  if q == 0: ret 0 - 1
  (*q).head = 0
  (*q).tail = 0
  (*q).len = 0
  ret 0

fn tz_event_queue_len(q:*TzEventQueue) -> int:
  if q == 0: ret 0
  ret (*q).len

fn tz_event_queue_dropped(q:*TzEventQueue) -> int:
  if q == 0: ret 0
  ret (*q).dropped

fn tz_event_push(q:*TzEventQueue, kind:int, key:int, x:int, y:int, buttons:int, mods:int, data:int) -> int:
  if q == 0: ret 0 - 1
  if (*q).len >= 256:
    (*q).dropped = (*q).dropped + 1
    ret 0 - 1
  idx:int = (*q).tail
  (*q).events[idx].kind = kind
  (*q).events[idx].key = key
  (*q).events[idx].x = x
  (*q).events[idx].y = y
  (*q).events[idx].buttons = buttons
  (*q).events[idx].mods = mods
  (*q).events[idx].data = data
  (*q).tail = ((*q).tail + 1) % 256
  (*q).len = (*q).len + 1
  ret 0

fn tz_event_push_key(q:*TzEventQueue, key:int) -> int:
  ret tz_event_push(q, TZ_EVENT_KEY, key, 0, 0, 0, 0, 0)

fn tz_event_push_pointer(q:*TzEventQueue, x:int, y:int, buttons:int, mods:int) -> int:
  ret tz_event_push(q, TZ_EVENT_POINTER, 0, x, y, buttons, mods, 0)

fn tz_event_push_button(q:*TzEventQueue, x:int, y:int, buttons:int, mods:int) -> int:
  ret tz_event_push(q, TZ_EVENT_BUTTON, 0, x, y, buttons, mods, 0)

fn tz_event_pop(q:*TzEventQueue, out:*TzEvent) -> int:
  if q == 0 || out == 0 || (*q).len == 0: ret 0
  idx:int = (*q).head
  (*out).kind = (*q).events[idx].kind
  (*out).key = (*q).events[idx].key
  (*out).x = (*q).events[idx].x
  (*out).y = (*q).events[idx].y
  (*out).buttons = (*q).events[idx].buttons
  (*out).mods = (*q).events[idx].mods
  (*out).data = (*q).events[idx].data
  (*q).head = ((*q).head + 1) % 256
  (*q).len = (*q).len - 1
  ret 1

fn tz_event_peek(q:*TzEventQueue, out:*TzEvent) -> int:
  if q == 0 || out == 0 || (*q).len == 0: ret 0
  idx:int = (*q).head
  (*out).kind = (*q).events[idx].kind
  (*out).key = (*q).events[idx].key
  (*out).x = (*q).events[idx].x
  (*out).y = (*q).events[idx].y
  (*out).buttons = (*q).events[idx].buttons
  (*out).mods = (*q).events[idx].mods
  (*out).data = (*q).events[idx].data
  ret 1
