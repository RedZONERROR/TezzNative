// Backend constants (mirror tensor module)
let ML_BACKEND_CPU:int = 0
let ML_BACKEND_GPU:int = 1
let ML_BACKEND_NPU:int = 2

// Backend selection (CPU/GPU/NPU)
fn backend_cpu() -> int:
  ret tensor.tensor_backend(ML_BACKEND_CPU)

fn backend_gpu() -> int:
  ret tensor.tensor_backend(ML_BACKEND_GPU)

fn backend_npu() -> int:
  ret tensor.tensor_backend(ML_BACKEND_NPU)

