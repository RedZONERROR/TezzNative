# ==========================================
# TezzNative Public Repository .gitignore
# Whitelist Strategy (Only tracks allowed files)
# ==========================================

# Ignore everything by default
*

# Allow directories
!lib/
!lib/**
!docs/
!docs/*.md
!benchmarks/
!benchmarks/**
benchmarks/results/
benchmarks/results/**
!ci/
!ci/bootstrap/
!ci/bootstrap/**
!examples/
!examples/dx/
!examples/dx/**
!projects/
!projects/tezzmind/
!projects/tezzmind/README.md
!projects/tezzmind/*.tn
!projects/tezzmind/*.mod
!projects/tezzmind/lib/
!projects/tezzmind/lib/*.tn
!projects/tezzmind/train_data/
!projects/tezzmind/train_data/*.txt
!.github/
!.github/workflows/
!.github/workflows/conformance.yml
!.github/workflows/release-security.yml
!tests/
!tests/conformance/
!tests/conformance/**
!tezznative-vscode/
!tezznative-vscode/**
!tools/
!tools/tezz.tn
!tools/tezz_lsp.tn
!tools/resolve_hashes.py
!tools/tezz_lib.py
!tools/release/
!tools/release/**

# Allow specific files
!README.md
!LICENSE.txt
!SECURITY.md
!version.json
!install.ps1
!install.sh
!install.cmd
!tezz
!tezz.cmd
!tezz.ps1
!tezz.mod
!tezz.lock
!registry.tnx
!.gitignore
!.gitattributes

# Exclude compiled binaries and node_modules inside extension
tezznative-vscode/node_modules/
tezznative-vscode/*.vsix

# ── TezzCorp Language Portal Website Sources ─────────────────────────────────
!TezzCorp_WebSites/
!TezzCorp_WebSites/tn_tezzcorp_com/
!TezzCorp_WebSites/tn_tezzcorp_com/**

# Never commit real secrets / log files / disaster recovery archives
TezzCorp_WebSites/tn_tezzcorp_com/.env
TezzCorp_WebSites/tn_tezzcorp_com/logs/
TezzCorp_WebSites/tn_tezzcorp_com/logs/**
TezzCorp_WebSites/tn_tezzcorp_com/storage/
TezzCorp_WebSites/tn_tezzcorp_com/storage/**
TezzCorp_WebSites/tn_tezzcorp_com/tezznative_source_backup.tar.gz
TezzCorp_WebSites/tn_tezzcorp_com/*source_backup*

